{
  "version": "3.5.1-vasl.3",
  "name": "gridman",
  "description": "Gridman API Client for Exploring and Testing APIs",
  "homepage": "https://github.com/shahramgit/gridman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahramgit/gridman.git"
  },
  "private": true,
  "main": "src/index.js",
  "author": "VASL contributors",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "electron .",
    "debug": "electron . --inspect=9229",
    "fetch-pty:mac": "node scripts/fetch-pty-binaries.js darwin",
    "fetch-pty:win": "node scripts/fetch-pty-binaries.js win32",
    "fetch-pty:linux": "node scripts/fetch-pty-binaries.js linux",
    "dist:mac": "npm run fetch-pty:mac && electron-builder --mac --x64 --arm64 --config electron-builder-config.js",
    "dist:win": "npm run fetch-pty:win && electron-builder --win --x64 --arm64 --config electron-builder-config.js",
    "dist:linux": "npm run fetch-pty:linux && electron-builder --linux AppImage --x64 --arm64 --config electron-builder-config.js",
    "dist:deb": "npm run fetch-pty:linux && electron-builder --linux deb --x64 --arm64 --config electron-builder-config.js",
    "dist:rpm": "npm run fetch-pty:linux && electron-builder --linux rpm --x64 --arm64 --config electron-builder-config.js",
    "dist:snap": "npm run fetch-pty:linux && electron-builder --linux snap --x64 --arm64 --config electron-builder-config.js",
    "pack": "electron-builder --dir",
    "test": "node --experimental-vm-modules $(npx which jest)"
  },
  "jest": {
    "modulePaths": [
      "node_modules"
    ]
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "3.1019.0",
    "@grpc/grpc-js": "^1.13.2",
    "@grpc/proto-loader": "^0.7.13",
    "@lydell/node-pty": "^1.1.0",
    "@usebruno/common": "0.1.0",
    "@usebruno/converters": "^0.1.0",
    "@usebruno/filestore": "^0.1.0",
    "@usebruno/js": "0.12.0",
    "@usebruno/lang": "0.12.0",
    "@usebruno/node-machine-id": "^2.0.0",
    "@usebruno/requests": "^0.1.0",
    "@usebruno/schema": "0.7.0",
    "about-window": "^1.15.2",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "aws4-axios": "^3.3.15",
    "axios": "1.16.0",
    "axios-ntlm": "^1.4.2",
    "chai": "^4.3.7",
    "chokidar": "^3.5.3",
    "content-disposition": "^0.5.4",
    "decomment": "^0.9.5",
    "diff": "^8.0.3",
    "dotenv": "^16.0.3",
    "electron-is-dev": "^2.0.0",
    "electron-notarize": "^1.2.2",
    "electron-store": "^8.1.0",
    "electron-util": "^0.17.2",
    "extract-zip": "^2.0.1",
    "form-data": "4.0.4",
    "fs-extra": "^10.1.0",
    "graphql": "^16.6.0",
    "hexy": "^0.3.5",
    "http-proxy-agent": "^7.0.0",
    "https-proxy-agent": "^7.0.2",
    "iconv-lite": "^0.6.3",
    "is-valid-path": "^0.1.1",
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "nanoid": "3.3.8",
    "qs": "^6.14.1",
    "simple-git": "3.32.3",
    "socks-proxy-agent": "^8.0.2",
    "tough-cookie": "^6.0.0",
    "uuid": "^10.0.0",
    "yup": "^0.32.11"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "devDependencies": {
    "electron": "~37.6.1",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^4.0.0"
  }
}
